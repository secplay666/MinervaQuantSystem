{
  "name": "multifactor_optimizer",
  "description": "多因子（27 个因子，类别等权）+ 均值-方差优化（风险模型：申万一级行业 + 风格；单股 2%，行业偏离 ±5%，规模暴露 ±0.5，单边换手 ≤ 50%）。回测区间由实验样本决定（ADR-009）。",
  "experiment": {
    "research_config": "configs/research/multifactor_v1.json"
  },
  "run": {
    "start": "2021-01-01",
    "end": "2023-12-31",
    "initial_capital_cny": "10000000"
  },
  "data": {
    "source": "duckdb",
    "path": "data/market.duckdb"
  },
  "market_rules": "configs/market_rules/cn_a_share.json",
  "strategy": {
    "id": "multifactor",
    "version": "1",
    "params": {
      "factors": "all",
      "weighting": "family_equal",
      "min_families": 4,
      "universe": {
        "size": 1800,
        "boards": [
          "SSE_MAIN",
          "SZSE_MAIN",
          "CHINEXT",
          "STAR"
        ],
        "min_listing_sessions": 250,
        "coverage_window": 60,
        "min_coverage": 0.8,
        "min_price": 2.0,
        "turnover_window": 20,
        "turnover_weight": 0.5,
        "exclude_risk_warning": true
      },
      "processing": {
        "winsorize_k": 3.0,
        "neutralize": true,
        "min_names": 30
      },
      "constructor": "optimizer",
      "construction": {
        "n_holdings": 100,
        "buffer": 1.5,
        "industry_deviation": 0.05,
        "max_weight": 0.02,
        "weighting": "equal",
        "adv_participation": 0.1,
        "liquidity_days": 1.0,
        "lot_tolerance": 1.2
      },
      "optimizer": {
        "risk_aversion": 20.0,
        "ic": 0.05,
        "candidates": 400,
        "max_weight": 0.02,
        "min_weight": 0.001,
        "industry_active": 0.05,
        "style_bounds": {
          "ln_float_mcap": 0.5
        },
        "max_turnover": 0.5,
        "holding_months": 6.0
      }
    }
  },
  "schedule": {
    "type": "month_end"
  },
  "portfolio": {
    "cash_buffer": 0.005,
    "band_rel": 0.25,
    "min_lot_policy": "skip"
  },
  "execution": {
    "price": "open",
    "slippage_bps": "5",
    "max_participation": 0.1,
    "buy_retry_sessions": 5,
    "delay_sessions": 1
  },
  "costs": {
    "commission_rate": "0.00025",
    "commission_min_cny": "5"
  },
  "delisting": {
    "settlement": "last_close"
  },
  "benchmarks": {
    "indices": [
      "H00905",
      "H00852",
      "H00300"
    ],
    "equal_weight_universe": true
  },
  "analytics": {
    "risk_free_rate": 0.0,
    "periods_per_year": 244
  }
}
