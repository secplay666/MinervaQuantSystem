{
  "name": "multifactor_holders_rules",
  "description": "多因子（现有 27 个因子 + 候选因子股东户数季度变化 holders_qoq，单独成“股东”一类，类别等权）+ 规则法组合，其余与 multifactor_rules 相同；用于和 27 因子版本对比（ADR-009）。",
  "experiment": {
    "research_config": "configs/research/holders_v1.json"
  },
  "run": {
    "start": "2021-01-01",
    "end": "2023-12-31",
    "initial_capital_cny": "10000000"
  },
  "data": {
    "source": "duckdb",
    "path": "data/market.duckdb"
  },
  "market_rules": "configs/market_rules/cn_a_share.json",
  "strategy": {
    "id": "multifactor",
    "version": "1",
    "params": {
      "factors": [
        "bp",
        "cfp_ttm",
        "dy_ttm",
        "ep_ttm",
        "sp_ttm",
        "accruals",
        "gross_margin_ttm",
        "leverage",
        "roa_ttm",
        "roe_ttm",
        "dni_yoy",
        "ni_yoy",
        "rev_yoy",
        "high_52w",
        "mom_12_1",
        "mom_6_1",
        "rev_1m",
        "ivol_60",
        "max_20",
        "vol_60",
        "abn_turn",
        "amihud_20",
        "turn_20",
        "ln_float_mcap",
        "amplitude_20",
        "pv_corr_20",
        "turn_vol_20",
        "holders_qoq"
      ],
      "weighting": "family_equal",
      "min_families": 4,
      "universe": {
        "size": 1800,
        "boards": [
          "SSE_MAIN",
          "SZSE_MAIN",
          "CHINEXT",
          "STAR"
        ],
        "min_listing_sessions": 250,
        "coverage_window": 60,
        "min_coverage": 0.8,
        "min_price": 2.0,
        "turnover_window": 20,
        "turnover_weight": 0.5,
        "exclude_risk_warning": true
      },
      "processing": {
        "winsorize_k": 3.0,
        "neutralize": true,
        "min_names": 30
      },
      "constructor": "rules",
      "construction": {
        "n_holdings": 100,
        "buffer": 1.5,
        "industry_deviation": 0.05,
        "max_weight": 0.02,
        "weighting": "equal",
        "adv_participation": 0.1,
        "liquidity_days": 1.0,
        "lot_tolerance": 1.2
      }
    }
  },
  "schedule": {
    "type": "month_end"
  },
  "portfolio": {
    "cash_buffer": 0.005,
    "band_rel": 0.25,
    "min_lot_policy": "skip"
  },
  "execution": {
    "price": "open",
    "slippage_bps": "5",
    "max_participation": 0.1,
    "buy_retry_sessions": 5,
    "delay_sessions": 1
  },
  "costs": {
    "commission_rate": "0.00025",
    "commission_min_cny": "5"
  },
  "delisting": {
    "settlement": "last_close"
  },
  "benchmarks": {
    "indices": [
      "H00905",
      "H00852",
      "H00300"
    ],
    "equal_weight_universe": true
  },
  "analytics": {
    "risk_free_rate": 0.0,
    "periods_per_year": 244
  }
}
